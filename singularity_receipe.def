    R -e "BiocManager::install('glmGamPoi')"
    
    R -e "remotes::install_github('chris-mcginnis-ucsf/DoubletFinder')"
    R -e "remotes::install_github('mojaveazure/seurat-disk')"
	R -e "remotes::install_github('satijalab/seurat-wrappers')"

    R -e "install.packages('Vennerable', dependencies=TRUE, repos='http://R-Forge.R-project.org')"
    R -e "install.packages('terra', version='1.5-34', dependencies=TRUE, repos='http://cran.rstudio.com/')"
    R -e "devtools::install_version('speedglm', '0.3-4', repos = 'https://packagemanager.rstudio.com/cran/2023-03-31')"
    R -e "devtools::install_github('cole-trapnell-lab/monocle3')"
    R -e "remotes::install_github('cole-trapnell-lab/cicero-release', ref = 'monocle3')"
    R -e "devtools::install_github('immunogenomics/lisi')"
    R -e "devtools::install_github('immunogenomics/presto')"
    
    #Install packages for CHOIR
    R -e "install.packages('igraph', version='2.0.2', dependencies=TRUE, repos='http://cran.rstudio.com/')"  
    R -e "remotes::install_github('corceslab/CHOIR', ref='main', repos = BiocManager::repositories(), upgrade = 'never')"

	#Matrix.utils not available anymore on CRAN, install from source
    wget https://cran.r-project.org/src/contrib/Archive/Matrix.utils/Matrix.utils_0.9.8.tar.gz
    R -e "install.packages('Matrix.utils_0.9.8.tar.gz', repos=NULL, type='source')"
    
    #geomnet not available anymore on CRAN, install from source
    wget https://cran.r-project.org/src/contrib/Archive/geomnet/geomnet_0.3.1.tar.gz
    R -e "install.packages('geomnet_0.3.1.tar.gz', repos=NULL, type='source')"
    
    #Install AMULET
    mkdir AMULET
    cd AMULET
    wget https://github.com/UcarLab/AMULET/releases/download/v1.1/AMULET-v1.1.zip
    unzip AMULET-v1.1.zip
    rm AMULET-v1.1.zip
    chmod +x AMULET.sh
    pwd

    #Install AMULET file requierements
    #Autosomes mouse
    echo "chr1\nchr2\nchr3\nchr4\nchr5\nchr6\nchr7\nchr8\nchr9\nchr10\nchr11\nchr12\nchr13\nchr14\nchr15\nchr16\nchr17\nchr18\nchr19" > mouse_autosomes.txt
    #RepeatMasker mouse
    wget http://www.repeatmasker.org/genomes/mm10/RepeatMasker-rm405-db20140131/mm10.fa.out.gz
    zcat mm10.fa.out.gz | awk -F " " 'NR>3{print$5"\t"$6-1"\t"$7}' > mm10.fa.bed
    #Change FragmentFileOverlapCounter.py l231 to read per_barcode_metrics.csv for Multiomics
    #https://github.com/UcarLab/AMULET/issues/11
    cp FragmentFileOverlapCounter.py FragmentFileOverlapCounter.py.BAK
    sed -i '231s/.*/    sc_data = sc_data[sc_data["is_cell"] == 1]/' FragmentFileOverlapCounter.py

    #Install CellRouter
    cd /
    mkdir CellRouter
    cd CellRouter
    git clone https://github.com/edroaldo/cellrouter.git
    
    #Print versions
    whereis macs2
    R --version
    R -e "installed.packages()[,c('LibPath', 'Version')]"
    python3 --version


