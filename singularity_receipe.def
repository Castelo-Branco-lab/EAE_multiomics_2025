Bootstrap: library
From: ubuntu:22.04

%post

    apt-get update -y
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        software-properties-common

    #Add universe repository to download fresh packages and Python PPA
    #add-apt-repository universe
    #add-apt-repository ppa:deadsnakes/ppa -y
    #apt-get update -y

    #Install specific version of nodejs
    apt-get install -y curl
    curl -sL https://deb.nodesource.com/setup_20.x | bash -
    
    #Python3.10 already installed
    python3 --version
       
    #Install tools and UNIX libraries
    DEBIAN_FRONTEND=noninteractive TZ=Etc/UTC apt-get install -y --no-install-recommends \
		python3-pip \
        python3-distutils \
        python3-setuptools \
        python3-wheel \
        python3-dev \
        dirmngr \
        gpg-agent \
        gnupg \
        apt-transport-https \
        ca-certificates \
        build-essential \
        libxml2-dev \
        libcurl4-openssl-dev \
        libz-dev \
        libssl-dev \
        libjpeg-dev \
        libpng-dev \
        libfreetype6-dev \
        libtiff5-dev \
        gfortran \
        libgsl-dev \
        libblas-dev \
        liblapack-dev \
        libhdf5-dev \
        libbz2-dev \
        liblzma-dev \
        libgeos-dev \
        libfontconfig1-dev \
        libfribidi-dev \
        libharfbuzz-dev \
        libcairo2-dev \
        libxt-dev\
		libfftw3-dev \
        libgdal-dev \
        libudunits2-dev \
        libnetcdf-dev \
        libgit2-dev \
        libzmq3-dev \
        libglpk-dev \
        libmagick++-dev \
        libavfilter-dev \
        tzdata \
        git \
        nodejs \
		wget \
        unzip \
		samtools \
        default-jre \
        default-jdk \
		cmake \
		ffmpeg \
		cargo

	#Install R=4.3.2
    curl -O https://cran.rstudio.com/src/base/R-4/R-4.3.2.tar.gz
	tar -xzvf R-4.3.2.tar.gz
	cd R-4.3.2
	./configure \
    	--prefix=/opt/R/4.3.2 \
    	--enable-R-shlib \
    	--enable-memory-profiling \
    	--with-blas \
    	--with-lapack \
    	--with-readline=no \
    	--with-x=yes \
    	--with-libpng=yes
    make
    make install
    
    /opt/R/4.3.2/bin/R --version
    ln -s /opt/R/4.3.2/bin/R /usr/local/bin/R
	ln -s /opt/R/4.3.2/bin/Rscript /usr/local/bin/Rscript
	
    #Save some space removing apt lists
    rm -rf /var/lib/apt/lists/*
	
	#Install python classic libraries
    python3 -m pip install numpy==1.24.3
    python3 -m pip install pandas==2.1.4
    
    #Install jupyter==1.0.0 & jupyterlab==4.1.1
    python3 -m pip install notebook==6.4.12
    
    #Install jupyterlab-sos
    python3 -m pip install jupyter_contrib_core==0.4.2
	python3 -m pip install jupyter_contrib_nbextensions==0.7.0
	python3 -m pip install jupyter-nbextensions-configurator==0.6.3
    python3 -m pip install jupyterlab-execute-time==3.1.1
    python3 -m pip install jupyterlab-sos==0.10.1
    python3 -m pip install sos-pbs==0.20.8
    python3 -m pip install sos-notebook==0.24.4
    python3 -m pip install sos-papermill==0.2.1
    
    #Install kernels
    python3 -m pip install tornado==6.4
    python3 -m pip install ipython==8.22.1
    python3 -m pip install sos-r==0.20.1
    python3 -m pip install sos-python==0.20.2
    python3 -m pip install sos-bash==0.21.0
    python3 -m pip install bash_kernel==0.9.3

    #Add sos to kernel list
    python3 -m sos.install
    python3 -m sos_notebook.install
    python3 -m bash_kernel.install

	#Install jupyterlab extensions
    python3 -m pip install transient-display-data==0.4.4
    python3 -m pip install jupyterlab-sos==0.10.1
    
    #Install MACS3 to peak recalculation
    python3 -m pip install macs3==3.0.0
    
    python3 -m pip install matplotlib==3.8.3
    
    python3 -m pip install scipy==1.12.0
    python3 -m pip install statsmodels==0.14.1
    python3 -m pip install multivelo==0.1.3

    #python3 -m pip install cython==3.0.8
    #python3 -m pip install scikit-learn==1.1.3
    python3 -m pip install pysam==0.22.0

    python3 -m pip install velocyto==0.17.17
    
    python3 -m pip install cellbender==0.3.0
    python3 -m pip install torch==1.13.1
    
    #Generate bigwig files
    python3 -m pip install deepTools==3.5.3
    python3 -m pip install sinto==0.10.0
      
    #Install Tensorflow
    python3 -m pip install tensorflow==2.13.0
    python3 -c "import tensorflow as tf; print(tf.reduce_sum(tf.random.normal([1000, 1000])))"
	python3 -c "import tensorflow as tf; print(tf.config.list_physical_devices('GPU'))"

    #Replace the name of the called bam files in velocyto
    sed -i 's/possorted_genome_bam/gex_possorted_bam/g' /usr/local/lib/python3.10/dist-packages/velocyto/commands/run10x.py

    #Replace the name of the called bam files in velocyto
    sed -i "s/knn_dists.astype(np.float32)/knn_dists.astype(np.float32,order='C')/g" /usr/local/lib/python3.10/dist-packages/umap/umap_.py

    #Install R packages

    #Install packages manager
    R -e "install.packages('BiocManager', version='3.18', dependencies=TRUE, repos='http://cran.rstudio.com/')"
    R -e "install.packages('devtools', version='2.4.5', dependencies=TRUE, repos='http://cran.rstudio.com/')"
    
    #Add R to kernel list
    R -e "install.packages('IRkernel', version='1.3.2', dependencies=TRUE, repos='http://cran.rstudio.com/')"
    R -e "IRkernel::installspec(user = FALSE, name='opt-r-4.3.2', displayname='R 4.3.2')"
    
    R -e "install.packages('Cairo', version='1.6', dependencies=TRUE, repos='http://cran.rstudio.com/')"
    
	echo '{\n"argv": ["/opt/R/4.3.2/lib/R/bin/R", "--slave", "-e", "options(bitmapType='"'"'cairo'"'"') ; IRkernel::main()", "--args", "{connection_file}"],\n"display_name": "R 4.3.2",\n"language": "R"\n}' > /usr/local/share/jupyter/kernels/opt-r-4.3.2/kernel.json

    R -e "install.packages('arrow', version='14.0.0.2', dependencies=TRUE, repos='http://cran.rstudio.com/')"
    
    #Install packages for Seurat
    R -e "BiocManager::install('multtest')"
    R -e "install.packages('Rcpp', version='1.0.12', dependencies=TRUE, repos='http://cran.rstudio.com/')"
    R -e "install.packages('reticulate', version='1.35.0', dependencies=TRUE, repos='http://cran.rstudio.com/')"
    R -e "install.packages('httr', version='1.4.7', dependencies=TRUE, repos='http://cran.rstudio.com/')"
    R -e "install.packages('qqconf', version='1.3.2', dependencies=TRUE, repos='http://cran.rstudio.com/')"
    R -e "install.packages('Seurat', version='5.0.1', dependencies=TRUE, repos='http://cran.rstudio.com/')"

    #Install packages for Signac
    R -e "BiocManager::install('GenomicRanges')"
    R -e "BiocManager::install('GenomeInfoDb')"
    R -e "BiocManager::install('Rhtslib')"
    R -e "BiocManager::install('Rsamtools')"
    R -e "BiocManager::install('S4Vectors')"
    R -e "BiocManager::install('SummarizedExperiment')"
    R -e "BiocManager::install('limma')"
    R -e "install.packages('Signac', version='1.12.0', dependencies=TRUE, repos='http://cran.rstudio.com/')"
    
    #Install packages for ArchR
    R -e "devtools::install_github('GreenleafLab/ArchR', ref='master', repos = BiocManager::repositories())"
    R -e "library(ArchR)"
    R -e "library(ArchR); ArchR::installExtraPackages()"
    R -e "library(ArchR); addArchRGenome('mm10')"

    #Install others R packages
    R -e "install.packages('harmony', version='1.2.0', dependencies=TRUE, repos='http://cran.rstudio.com/')"
    R -e "install.packages('clustree', version='0.5.1', dependencies=TRUE, repos='http://cran.rstudio.com/')"
